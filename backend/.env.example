# ── AIFlow Backend Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── Model API Keys (optional — fallback simulator runs without keys) ───────────
# Groq API key — get one free at console.groq.com
GROQ_API_KEY=

# Google Gemini API key (reserved for future Gemini-Flash tier)
GEMINI_API_KEY=

# ── Carbon Intensity (optional live feed) ─────────────────────────────────────
# Electricity Maps API key — free tier at electricitymaps.com
# Without this, the static table from regions.ts is used (no functionality lost)
ELECTRICITY_MAPS_API_KEY=

# ── Server Configuration ──────────────────────────────────────────────────────
# Set to "false" in production to restrict CORS to explicit origins only
DEV_MODE=true

# ── Debug / Demo Flags ────────────────────────────────────────────────────────
# Set to "1" to force escalation on every small-model attempt (demo reliability)
DEBUG_FORCE_ESCALATE=0

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite file path (relative to where uvicorn is run, i.e., the backend/ dir)
# DATABASE_URL is derived from DB_PATH — no need to set unless changing the file
# DB_PATH=aiflow.db
